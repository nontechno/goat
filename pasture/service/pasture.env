# pasture service settings: ~/.config/pasture/pasture.env
# Read by the systemd user unit (pasture.service). After editing:
#   systemctl --user restart pasture     # NOTE: restarting ends all programs on it
#
# Lines are KEY=VALUE (no "export", no shell expansion).

# Extra command-line flags for pasture (see: pasture -h).
#   -log-level=debug|info|warn|error    (info is plenty; debug logs every request)
#   -S=/path/to/socket                  (then give goat the same socket)
#   -history-max=64M                    history moved to disk per pane (0 = keep only what fits in memory)
#   -history-dir=/path                  where that history goes (default: <socket>.history, private)
PASTURE_ARGS=-log-level=info

# Directory for the socket (default /tmp): the socket is
# $PASTURE_TMPDIR/pasture-<uid>/default. If you change it, goat must see the
# same value (export PASTURE_TMPDIR in your shell profile too).
#PASTURE_TMPDIR=/tmp
